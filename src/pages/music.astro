---
import { getCollection, render } from 'astro:content';
import '../styles/global.css';

const releases = await getCollection('music');

const renderedReleases = await Promise.all(
  releases.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);

const hasImageLogo = false;
const logoPath = '/logo.svg';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tyler Lacroix — Guitar & Audio</title>
</head>
<body class="bg-stone-950 text-stone-100 min-h-screen font-sans selection:bg-stone-700">

  <!-- Navigation / Brand Bar -->
  <header class="p-6 sm:p-10 border-b border-stone-900 flex justify-between items-center sticky top-0 bg-stone-950/90 backdrop-blur-md z-20">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-3 group">
        {hasImageLogo ? (
          <img src={logoPath} alt="Tyler Lacroix" class="h-7 w-auto object-contain filter invert" />
        ) : (
          <span class="text-sm font-semibold tracking-[0.25em] uppercase text-stone-200 group-hover:text-stone-400 transition-colors">
            TL
          </span>
        )}
      </a>
      <span class="text-stone-700 font-light">/</span>
      <span class="text-xs uppercase tracking-[0.25em] text-stone-400 font-medium">Audio</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="/" class="text-xs uppercase tracking-widest text-stone-500 hover:text-stone-200 transition-colors">
        Overview
      </a>
      <a href="/visual/" class="text-xs uppercase tracking-widest text-stone-500 hover:text-stone-200 transition-colors">
        Visual &rarr;
      </a>
    </div>
  </header>

  <!-- Intro Block At Top -->
  <section class="max-w-5xl mx-auto px-6 sm:px-10 pt-12 pb-8">
    <h1 class="text-3xl sm:text-5xl font-light tracking-tight text-white mb-4">
      Guitar &amp; Sonic Works
    </h1>
    <p class="text-stone-400 font-light max-w-2xl text-base sm:text-lg leading-relaxed">
      Tone design, live takes, rhythm architecture, and heavy groove sessions. Exploring dynamic shifts from atmospheric ambient passages to drop-tuned weight.
    </p>
  </section>

  <!-- Track Listing & Player Layout -->
  <main class="max-w-5xl mx-auto px-6 sm:px-10 pb-16">
    {renderedReleases.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-stone-600 font-light text-sm uppercase tracking-widest">No audio entries published yet</p>
      </div>
    ) : (
      <div class="divide-y divide-stone-900">
        {renderedReleases.map(({ data, Content }) => (
          <article class="py-8 flex flex-col gap-5 group">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
              <div class="flex items-center gap-5">
                {data.coverImage && (
                  <div class="w-16 h-16 sm:w-20 sm:h-20 bg-stone-900 shrink-0 overflow-hidden border border-stone-800">
                    <img 
                      src={data.coverImage} 
                      alt={data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  </div>
                )}
                <div>
                  <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-stone-500 mb-1">
                    <span>{data.project}</span>
                    <span>&bull;</span>
                    <span>{data.releaseType}</span>
                    <span>&bull;</span>
                    <span class="font-mono">{data.year}</span>
                  </div>
                  <h2 class="text-2xl font-light text-white group-hover:text-stone-300 transition-colors">
                    {data.title}
                  </h2>
                  <span class="text-xs text-stone-400 font-light block mt-0.5">
                    Role: {data.role}
                  </span>
                </div>
              </div>

              <!-- Inline Audio Player -->
              {data.audioUrl && (
                <div class="w-full sm:w-72 mt-2 sm:mt-0">
                  <audio 
                    controls 
                    preload="none" 
                    class="w-full h-8 brightness-90 contrast-125 accent-stone-400"
                  >
                    <source src={data.audioUrl} type="audio/mpeg" />
                    Your browser does not support audio playback.
                  </audio>
                </div>
              )}
            </div>

            <!-- Track Description / Markdown Notes -->
            <div class="text-sm text-stone-400 font-light leading-relaxed max-w-2xl pl-0 sm:pl-25">
              <Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </main>

</body>
</html>
