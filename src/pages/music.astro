---
import { getCollection, render } from 'astro:content';
import generalSettings from '../content/settings/general.json';
import '../styles/global.css';

const releases = await getCollection('music');

const renderedReleases = await Promise.all(
  releases.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tyler Lacroix — Guitar & Audio</title>
</head>
<body class="bg-stone-950 text-stone-100 min-h-screen font-sans selection:bg-stone-700">

  <!-- Header -->
  <header class="p-6 sm:p-10 border-b border-stone-900 flex justify-between items-center sticky top-0 bg-stone-950/95 backdrop-blur-md z-20">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-3 group">
        {generalSettings.logo ? (
          <img src={generalSettings.logo} alt="Tyler Lacroix" class="h-7 w-auto object-contain filter invert" />
        ) : (
          <span class="text-sm font-semibold tracking-[0.25em] uppercase text-stone-200 group-hover:text-stone-400 transition-colors">
            {generalSettings.monogram || 'TL'}
          </span>
        )}
      </a>
      <span class="text-stone-700 font-light">/</span>
      <span class="text-xs uppercase tracking-[0.25em] text-stone-400 font-medium">Audio</span>
    </div>

    <div class="flex items-center gap-6 text-xs uppercase tracking-widest text-stone-400">
      <a href="/visual/" class="hover:text-white transition-colors">Visual</a>
      <a href="/about/" class="hover:text-white transition-colors">About</a>
    </div>
  </header>

  <!-- CMS Intro Block -->
  <section class="max-w-5xl mx-auto px-6 sm:px-10 pt-12 pb-8">
    <h1 class="text-3xl sm:text-5xl font-light tracking-tight text-white mb-4">
      {generalSettings.audioHeadline}
    </h1>
    <p class="text-stone-400 font-light max-w-2xl text-base sm:text-lg leading-relaxed">
      {generalSettings.audioSubtext}
    </p>
  </section>

  <!-- Tracks -->
  <main class="max-w-5xl mx-auto px-6 sm:px-10 pb-16">
    {renderedReleases.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-stone-600 font-light text-sm uppercase tracking-widest">No audio entries published yet</p>
      </div>
    ) : (
      <div class="divide-y divide-stone-900">
        {renderedReleases.map(({ data, Content }) => (
          <article class="py-8 flex flex-col gap-5 group">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
              <div class="flex items-center gap-5">
                {data.coverImage && (
                  <div class="w-16 h-16 sm:w-20 sm:h-20 bg-stone-900 shrink-0 overflow-hidden rounded-xs border border-stone-800">
                    <img 
                      src={data.coverImage} 
                      alt={data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}
                <div>
                  <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-stone-500 mb-1">
                    <span>{data.project}</span>
                    <span>&bull;</span>
                    <span>{data.releaseType}</span>
                    <span>&bull;</span>
                    <span class="font-mono">{data.year}</span>
                  </div>
                  <h2 class="text-2xl font-light text-white group-hover:text-stone-300 transition-colors">
                    {data.title}
                  </h2>
                  <span class="text-xs text-stone-400 font-light block mt-0.5">
                    Role: {data.role}
                  </span>
                </div>
              </div>

              {data.audioUrl && (
                <div class="w-full sm:w-72 mt-2 sm:mt-0">
                  <audio controls preload="none" class="w-full h-8 brightness-90 contrast-125 accent-stone-400">
                    <source src={data.audioUrl} type="audio/mpeg" />
                  </audio>
                </div>
              )}
            </div>

            <div class="text-sm text-stone-400 font-light leading-relaxed max-w-2xl">
              <Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </main>

</body>
</html>
