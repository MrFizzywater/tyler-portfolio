---
import generalSettings from '../content/settings/general.json';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tyler Lacroix</title>
</head>
<body class="bg-stone-950 text-white min-h-screen overflow-x-hidden font-sans selection:bg-stone-800 relative">

  <!-- Subtle About & Contact (Top Right) -->
  <nav class="absolute top-6 right-6 sm:top-8 sm:right-10 z-40">
    <a 
      href="/about/" 
      class="text-[11px] sm:text-xs uppercase tracking-[0.25em] text-stone-500 hover:text-stone-200 transition-colors duration-300 py-2 px-1"
    >
      About &amp; Contact
    </a>
  </nav>

  <!-- Centered Logo Dropped Down ~15% -->
  <header class="absolute top-[15%] left-0 right-0 -translate-y-1/2 z-30 flex justify-center items-center pointer-events-none px-6">
    <a href="/" class="pointer-events-auto flex flex-col items-center group transition-transform duration-300 hover:scale-105">
      {generalSettings.logo ? (
        <img 
          src={generalSettings.logo} 
          alt="Tyler Lacroix" 
          class="h-16 sm:h-24 md:h-28 w-auto object-contain filter drop-shadow-xl"
        />
      ) : (
        <span class="text-3xl sm:text-4xl md:text-5xl font-light tracking-[0.4em] uppercase text-white/90 group-hover:text-white transition-colors">
          {generalSettings.monogram || 'TL'}
        </span>
      )}
    </a>
  </header>

  <!-- Split Screen Layout -->
  <main class="grid grid-cols-1 md:grid-cols-2 min-h-screen">
    
    <!-- Left: Visual Column -->
    <a 
      href="/visual/" 
      class="group relative flex flex-col justify-end p-8 sm:p-16 min-h-[50vh] md:min-h-screen bg-[#faf9f6] text-stone-950 transition-all duration-700 ease-out hover:brightness-105 overflow-hidden"
    >
      <div class="absolute inset-0 bg-stone-200/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
      
      <div class="relative z-10 transition-transform duration-500 group-hover:-translate-y-2">
        <span class="text-xs uppercase tracking-[0.35em] text-stone-400 block mb-3 font-medium">
          Portfolio &bull; Direction
        </span>
        <h2 class="text-4xl sm:text-6xl font-light tracking-tight text-stone-950">
          Visual
        </h2>
        <p class="text-stone-500 font-light mt-3 text-sm sm:text-base max-w-sm">
          Photography, visual framing, and film production.
        </p>
        <span class="inline-block mt-6 text-xs uppercase tracking-[0.25em] text-stone-950 border-b border-stone-950 pb-0.5">
          Enter Gallery &rarr;
        </span>
      </div>
    </a>

    <!-- Right: Audio / ASPIRA Column -->
    <a 
      href="/music/" 
      class="group relative flex flex-col justify-end p-8 sm:p-16 min-h-[50vh] md:min-h-screen bg-stone-950 text-white transition-all duration-700 ease-out hover:brightness-125 overflow-hidden border-t md:border-t-0 md:border-l border-stone-800"
    >
      <div class="absolute inset-0 bg-stone-900/50 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

      <div class="relative z-10 transition-transform duration-500 group-hover:-translate-y-2">
        <span class="text-xs uppercase tracking-[0.35em] text-stone-500 block mb-3 font-medium">
          ASPIRA &bull; Tone Design
        </span>
        <h2 class="text-4xl sm:text-6xl font-light tracking-tight text-white">
          Audio
        </h2>
        <p class="text-stone-400 font-light mt-3 text-sm sm:text-base max-w-sm">
          Guitar work, groove architecture, and sound design.
        </p>
        <span class="inline-block mt-6 text-xs uppercase tracking-[0.25em] text-stone-200 border-b border-stone-200 pb-0.5">
          Listen &rarr;
        </span>
      </div>
    </a>

  </main>

</body>
</html>
